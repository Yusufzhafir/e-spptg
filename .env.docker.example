# E-SPPTG — env untuk deployment Docker on-prem.
# Salin ke `.env` di root project pada server, lalu isi nilai sebenarnya:
#   cp .env.docker.example .env && chmod 600 .env
#
# Catatan: file `.env` ini dipakai dua kali oleh docker compose —
#   1) interpolasi build arg (NEXT_PUBLIC_*, S3_BUCKET_NAME, S3_DOMAIN)
#   2) environment runtime container (env_file)
# Ubah nilai NEXT_PUBLIC_* => WAJIB rebuild image, bukan cuma restart.

# ---------------------------------------------------------------------------
# Aplikasi
# ---------------------------------------------------------------------------
NODE_ENV=production
TZ=Asia/Makassar
APP_DOMAIN=siaptah.kutaitimurkab.go.id

# ---------------------------------------------------------------------------
# URL publik aplikasi. Dipakai untuk menyusun tautan absolut di email reset
# kata sandi. Kalau kosong, sistem memakai https://$APP_DOMAIN.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://siaptah.kutaitimurkab.go.id

# Kode verifikasi Google Search Console (metode "Tag HTML"): isi HANYA nilai
# content="..."-nya, tanpa tag lengkap. Dibaca saat `docker compose build`,
# bukan saat runtime — halaman depan di-prerender, jadi mengubah nilai ini
# menuntut build ulang. Boleh dikosongkan kalau verifikasi memakai file HTML.
GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# SMTP (butuh outbound port 465/587 dari server)
# Satu-satunya layanan pihak ketiga yang tersisa: dipakai HANYA untuk mengirim
# email verifikasi, "lupa kata sandi", dan undangan akun baru.
#
# SMTP_PORT 465 = TLS langsung, 587 = STARTTLS. SMTP_SECURE opsional — default
# true hanya untuk port 465; isi manual kalau server memakai TLS langsung di
# port lain. MAIL_FROM_ADDRESS opsional, default mengikuti SMTP_USER.
#
# Kalau SMTP_USER/SMTP_PASSWORD kosong, aplikasi tetap jalan: login dan
# pendaftaran normal, tetapi "lupa kata sandi" dan undangan akun akan gagal
# dengan pesan "Layanan email belum dikonfigurasi".
#
# Deployment lama yang masih memakai GMAIL_USER/GMAIL_APP_PASSWORD tetap
# berfungsi (dipakai sebagai fallback bila SMTP_* kosong), tapi sebaiknya
# dimigrasikan ke variabel SMTP_* di bawah.
# ---------------------------------------------------------------------------
SMTP_HOST=mail.kutaitimurkab.go.id
SMTP_PORT=465
SMTP_USER=ISI_ALAMAT_EMAIL
SMTP_PASSWORD=ISI_KATA_SANDI_EMAIL
MAIL_FROM_NAME=SIAPTAH

# ---------------------------------------------------------------------------
# Google Maps (butuh outbound HTTPS; restrict key ke referrer domain di atas)
# Ambil dari Google Cloud Console > Credentials.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=ISI_GOOGLE_MAPS_API_KEY

# ---------------------------------------------------------------------------
# Redis — jalan sebagai container `e-spptg-redis` di compose ini (bukan di host).
# Dipakai untuk sesi login, rate limit, dan cache baca.
#
# Hostname `redis` adalah nama service di docker-compose.yml; hanya bisa
# dijangkau dari dalam network compose, tidak dari host maupun publik.
#
# REDIS_PASSWORD WAJIB diisi — compose menolak start kalau kosong.
# Buat dengan: openssl rand -base64 24
#
# Kalau REDIS_URL dikosongkan, aplikasi tetap jalan tanpa Redis: sesi kembali
# ke tabel `sessions` di Postgres, rate limit kembali ke memori proses, dan
# cache dilewati. Berguna untuk pengembangan lokal tanpa Redis.
# ---------------------------------------------------------------------------
REDIS_PASSWORD=GANTI_PASSWORD_REDIS
REDIS_URL=redis://:GANTI_PASSWORD_REDIS@redis:6379
# Batas memori Redis. Kalau penuh, Redis menolak tulis dan aplikasi jatuh ke
# Postgres — bukan membuang sesi yang sedang dipakai.
REDIS_MAXMEMORY=256mb

# ---------------------------------------------------------------------------
# API Statistik (/api/statistik) — integrasi dashboard eksekutif.
# Hanya baca, hanya data agregat, tidak memuat data pribadi pemohon.
# Lihat docs/API-STATISTIK.md untuk contoh pemakaian.
#
# Daftar client, dipisah koma: "clientId:secret,clientId2:secret2".
# clientId boleh dibagikan (muncul di log); secret diperlakukan seperti sandi.
# Buat secret dengan: openssl rand -base64 32
# Kosongkan variabel ini untuk mematikan API statistik sepenuhnya (default).
# ---------------------------------------------------------------------------
STATISTIK_API_CLIENTS=

# IP publik server yang boleh memanggil API statistik, dipisah koma.
# KOSONG = semua IP diizinkan (hanya untuk masa uji coba). Isi begitu IP server
# dashboard diketahui — ini lapisan kedua kalau secret-nya bocor.
STATISTIK_API_ALLOWED_IPS=

# ---------------------------------------------------------------------------
# NOTIFIKASI PUSH (Web Push) — notifikasi di peramban dan PWA saat ada
# pengajuan SPPTG baru atau perubahan status.
#
# Buat sepasang kunci VAPID sekali saja:
#   npx web-push generate-vapid-keys
#
# Kosongkan ketiganya untuk mematikan notifikasi perangkat (default). Lonceng
# notifikasi di dalam aplikasi tetap berjalan tanpa kunci ini.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontak pengelola untuk layanan push (Google/Mozilla/Apple), wajib mailto:
VAPID_SUBJECT=mailto:siaptah@kutaitimurkab.go.id

# ---------------------------------------------------------------------------
# PostgreSQL 16 + PostGIS — jalan di HOST, bukan di container.
# host.docker.internal dipetakan ke gateway host lewat extra_hosts.
# Tidak ada pooler di on-prem: DATABASE_URL dan DATABASE_URL_DDL sama-sama 5432.
#   DATABASE_URL      -> dipakai runtime aplikasi
#   DATABASE_URL_DDL  -> dipakai drizzle-kit (service `migrate`)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://espptg:GANTI_PASSWORD@host.docker.internal:5432/espptg
DATABASE_URL_DDL=postgresql://espptg:GANTI_PASSWORD@host.docker.internal:5432/espptg

# Koneksi maksimum yang dipegang container aplikasi. Kosong = 20, cukup untuk
# ~50 orang bekerja bersamaan. Jangan melebihi max_connections PostgreSQL (default
# 100) dikurangi sisa untuk psql, backup, dan service `migrate`.
DATABASE_POOL_MAX=

# Batas percobaan pendaftaran mandiri per IP. Kosong = 10 per 5 menit.
# Satu ruangan pelatihan = satu IP, jadi naikkan untuk hari-H lalu kembalikan.
REGISTER_RATE_LIMIT=
REGISTER_RATE_LIMIT_WINDOW_MINUTES=

# ---------------------------------------------------------------------------
# SSO Kutai Timur (Keycloak realm `kutimkab`) — OPSIONAL, mati secara bawaan.
#
# SSO bersifat TAMBAHAN. Dengan SSO_ENABLED=true, form email + kata sandi tetap
# berjalan seperti biasa untuk SEMUA akun (termasuk @gmail.com); yang bertambah
# hanyalah tombol "Masuk dengan SSO Kutai Timur" untuk akun instansi.
# Dengan SSO_ENABLED=false tombol hilang dan seluruh route SSO menjawab 404.
#
# SSO_REDIRECT_URI harus SAMA PERSIS dengan "Valid Redirect URIs" di dashboard
# SSO — beda skema, port, atau garis miring di akhir sudah cukup membuat
# Keycloak menolak dengan "Invalid parameter: redirect_uri".
# ---------------------------------------------------------------------------
SSO_ENABLED=false
SSO_ISSUER=https://sso.kutaitimurkab.go.id/auth/realms/kutimkab
SSO_CLIENT_ID=siaptah-kutim
# Kosongkan untuk Public Client (PKCE saja, sesuai manual Diskominfo). Diisi
# untuk Confidential Client — aplikasi ini punya server, jadi bisa menyimpannya.
# PKCE tetap dikirim pada kedua mode. JANGAN commit nilai aslinya.
SSO_CLIENT_SECRET=
SSO_REDIRECT_URI=https://siaptah.kutaitimurkab.go.id/callbacksso
# Domain yang boleh masuk lewat SSO, dipisah koma. Kosong = semua domain yang
# ada di realm diterima.
SSO_ALLOWED_EMAIL_DOMAINS=kutaitimurkab.go.id
# Kosong = normal. `login` memaksa Keycloak selalu meminta kredensial, sehingga
# "keluar lalu masuk sebagai orang lain" tidak diam-diam memakai sesi SSO lama.
SSO_PROMPT=
# Hanya perlu untuk Public Client (tanpa client secret): kunci penanda tangan
# cookie handshake. Kosong = kunci acak per proses, yang berarti login yang
# sedang berjalan putus saat container restart.
SSO_STATE_SECRET=

# ---------------------------------------------------------------------------
# MinIO — jalan di HOST (127.0.0.1:9000), tidak dibuka ke publik.
#
# S3_ENDPOINT harus URL yang BISA DIBUKA BROWSER, karena presigned URL
# (download dokumen & template) memakai host dari endpoint ini. Port 9000
# tertutup dari luar, jadi endpoint = domain publik dan nginx meneruskan
# path /BUCKET/... ke MinIO (lihat deploy/nginx/e-spptg.conf).
#
# Konsekuensinya S3_FORCE_PATH_STYLE wajib true (MinIO tanpa wildcard DNS).
# Nama bucket menjadi prefix path publik -> jangan bentrok dengan route
# aplikasi (/, /app, /api, /sign-in, /sign-up).
# ---------------------------------------------------------------------------
S3_ENDPOINT=https://siaptah.kutaitimurkab.go.id
S3_PUBLIC_URL=https://siaptah.kutaitimurkab.go.id
S3_DOMAIN=siaptah.kutaitimurkab.go.id
S3_BUCKET_NAME=spptg-files
S3_FORCE_PATH_STYLE=true

# Kredensial MinIO (nama variabel pakai AWS_* karena SDK-nya @aws-sdk/client-s3).
# Pakai user/service-account MinIO khusus aplikasi, bukan root credential.
AWS_ACCESS_KEY_ID=GANTI_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=GANTI_SECRET_KEY
AWS_REGION=us-east-1
