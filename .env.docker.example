# E-SPPTG — env untuk deployment Docker on-prem.
# Salin ke `.env` di root project pada server, lalu isi nilai sebenarnya:
#   cp .env.docker.example .env && chmod 600 .env
#
# Catatan: file `.env` ini dipakai dua kali oleh docker compose —
#   1) interpolasi build arg (NEXT_PUBLIC_*, S3_BUCKET_NAME, S3_DOMAIN)
#   2) environment runtime container (env_file)
# Ubah nilai NEXT_PUBLIC_* => WAJIB rebuild image, bukan cuma restart.

# ---------------------------------------------------------------------------
# Aplikasi
# ---------------------------------------------------------------------------
NODE_ENV=production
TZ=Asia/Makassar
APP_DOMAIN=siaptah.kutaitimurkab.go.id

# ---------------------------------------------------------------------------
# Clerk (butuh outbound HTTPS ke clerk.com dari server)
# Ambil dari dashboard Clerk > API keys (kunci live untuk produksi).
# Placeholder di bawah sengaja tidak memakai awalan asli kunci Clerk supaya
# tidak diblokir secret scanning GitHub (polanya sama dengan kunci Stripe).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=ISI_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=ISI_CLERK_SECRET_KEY

# ---------------------------------------------------------------------------
# Google Maps (butuh outbound HTTPS; restrict key ke referrer domain di atas)
# Ambil dari Google Cloud Console > Credentials.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=ISI_GOOGLE_MAPS_API_KEY

# ---------------------------------------------------------------------------
# PostgreSQL 16 + PostGIS — jalan di HOST, bukan di container.
# host.docker.internal dipetakan ke gateway host lewat extra_hosts.
# Tidak ada pooler di on-prem: DATABASE_URL dan DATABASE_URL_DDL sama-sama 5432.
#   DATABASE_URL      -> dipakai runtime aplikasi
#   DATABASE_URL_DDL  -> dipakai drizzle-kit (service `migrate`)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://espptg:GANTI_PASSWORD@host.docker.internal:5432/espptg
DATABASE_URL_DDL=postgresql://espptg:GANTI_PASSWORD@host.docker.internal:5432/espptg

# ---------------------------------------------------------------------------
# MinIO — jalan di HOST (127.0.0.1:9000), tidak dibuka ke publik.
#
# S3_ENDPOINT harus URL yang BISA DIBUKA BROWSER, karena presigned URL
# (download dokumen & template) memakai host dari endpoint ini. Port 9000
# tertutup dari luar, jadi endpoint = domain publik dan nginx meneruskan
# path /BUCKET/... ke MinIO (lihat deploy/nginx/e-spptg.conf).
#
# Konsekuensinya S3_FORCE_PATH_STYLE wajib true (MinIO tanpa wildcard DNS).
# Nama bucket menjadi prefix path publik -> jangan bentrok dengan route
# aplikasi (/, /app, /api, /sign-in, /sign-up).
# ---------------------------------------------------------------------------
S3_ENDPOINT=https://siaptah.kutaitimurkab.go.id
S3_PUBLIC_URL=https://siaptah.kutaitimurkab.go.id
S3_DOMAIN=siaptah.kutaitimurkab.go.id
S3_BUCKET_NAME=spptg-files
S3_FORCE_PATH_STYLE=true

# Kredensial MinIO (nama variabel pakai AWS_* karena SDK-nya @aws-sdk/client-s3).
# Pakai user/service-account MinIO khusus aplikasi, bukan root credential.
AWS_ACCESS_KEY_ID=GANTI_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=GANTI_SECRET_KEY
AWS_REGION=us-east-1
