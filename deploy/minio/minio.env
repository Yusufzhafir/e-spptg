# MinIO di HOST (AlmaLinux 10) — dipasang di /etc/default/minio
# Dipakai oleh unit systemd bawaan RPM MinIO (minio.service).
#
# PENTING: MinIO tidak boleh terekspos ke publik. Port 9000/9001 hanya loopback;
# akses browser ke objek lewat nginx (https://siaptah.kutaitimurkab.go.id/<bucket>/...).

# Data harus di SSD lokal, JANGAN di NFS/NAS.
MINIO_VOLUMES="/srv/minio/data"

# API 9000 + console 9001, keduanya bind ke loopback saja.
MINIO_OPTS="--address 127.0.0.1:9000 --console-address 127.0.0.1:9001"

# Root credential — HANYA untuk administrasi (mc). Aplikasi memakai
# service account terpisah (lihat runbook, langkah MinIO).
MINIO_ROOT_USER=espptg-admin
MINIO_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_MINIO

# URL publik objek. Membuat MinIO konsisten saat berada di belakang nginx
# (redirect & presigned URL memakai domain, bukan 127.0.0.1:9000).
MINIO_SERVER_URL="https://siaptah.kutaitimurkab.go.id"

MINIO_REGION=us-east-1
